OPENAI_API_KEY=your_openai_api_key
OPENAI_SCRIPT_MODEL=gpt-4o-mini
OPENAI_PROMPT_MODEL=gpt-4o-mini
OPENAI_INPUT_PRICE_PER_1M_TOKENS=0.15
OPENAI_OUTPUT_PRICE_PER_1M_TOKENS=0.60

FAL_KEY=your_fal_api_key
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video
FAL_TEXT_VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/text-to-video
FAL_VIDEO_EDIT_MODEL=fal-ai/kling-video/o1/video-to-video/edit
FAL_VIDEO_DURATION_SECONDS=15
FAL_IMAGE_PRICE_USD=0.04
FAL_VIDEO_PRICE_PER_SECOND_USD=0.14
FAL_VIDEO_AUDIO_OFF_PRICE_PER_SECOND_USD=0.07
FAL_VIDEO_AUDIO_ON_PRICE_PER_SECOND_USD=0.14
FAL_VIDEO_EDIT_PRICE_PER_SECOND_USD=0.168

MAGICA_API_KEY=your_magica_api_key
MAGICA_BASE_URL=https://inference.magica.com/v1
MAGICA_IMAGE_PROVIDER_ENABLED=true
MAGICA_IMAGE_MODEL_NODE_TYPE=flux_2_max
MAGICA_TEXT_IMAGE_SUBMODEL=flux-2-max-text
MAGICA_IMAGE_OUTPUT_FORMAT=JPEG
MAGICA_VIDEO_PROVIDER_ENABLED=true
MAGICA_VIDEO_MODEL_NODE_TYPE=seedance_2_0_fast
MAGICA_TEXT_VIDEO_SUBMODEL=seedance-2.0-fast-text-to-video
MAGICA_IMAGE_VIDEO_SUBMODEL=seedance-2.0-fast-image-to-video
MAGICA_VIDEO_EDIT_PROVIDER_ENABLED=true
MAGICA_VIDEO_EDIT_MODEL_NODE_TYPE=kling_o3_pro_video_edit
MAGICA_POLL_INTERVAL_SECONDS=3
MAGICA_TIMEOUT_SECONDS=900
MAGICA_480P_PRICE_PER_SECOND_USD=0.1076
MAGICA_720P_PRICE_PER_SECOND_USD=0.2419

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=jctranz_ai

APP_NAME=Jctranz AI Workflow
APP_ENV=development
API_V1_PREFIX=/api/v1

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=jctranz_ai_assets
