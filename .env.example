OPENAI_API_KEY=your_openai_api_key
OPENAI_SCRIPT_MODEL=gpt-4o-mini

FAL_KEY=your_fal_api_key
FAL_VIDEO_MODEL=fal-ai/kling-video/v1.6/pro/image-to-video
FAL_TEXT_VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/text-to-video
FAL_VIDEO_DURATION_SECONDS=15

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=jctranz_ai

APP_NAME=Jctranz AI Workflow
APP_ENV=development
API_V1_PREFIX=/api/v1

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=jctranz_ai_assets
